SMTP_PORT=587
SMTP_USERNAME=no-reply@norsk.example.com
SMTP_PASSWORD=example-smtp-password-change-me
SMTP_FROM=Norsk Audio <no-reply@norsk.example.com>
SMTP_SECURITY=starttls

# --- Payments (Pro plan: 30 EUR / 32 USD / 320 NOK) ---
# Vipps environment: test | production  (Stripe's mode follows its keys)
PAYMENT_ENVIRONMENT=test

# Vipps MobilePay ePayment API - portal.vippsmobilepay.com -> Utvikler -> Test keys
VIPPS_CLIENT_ID=fb492b5e-7907-4d83-ba20-c7fb60ca35de
VIPPS_CLIENT_SECRET=Y8Kteew6GE2ZmeycEt6egg==
VIPPS_SUBSCRIPTION_KEY=0f14ebcab0ec4b29ae0cb90d91b4a84a
